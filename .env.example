# Klucz Gemini - WYLACZNIE po stronie serwera, nigdy w kodzie frontendu.
GEMINI_API_KEY=

# Model (domyslnie gemini-3.6-flash, zapasowo gemini-flash-lite-latest).
# gemini-2.5-flash jest wycofany dla nowych kluczy - odpowiada bledem 404.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Prog przelaczenia na model zapasowy. Model glowny bywa szybki (5-7 s), ale
# potrafi skoczyc do 25 s - wtedy lepiej oddac odpowiedz z modelu lite (1-2 s).
GEMINI_TIMEOUT_MS=9000

# Allowlista Origin (rozdzielona przecinkami)
ALLOWED_ORIGINS=https://emmastudio.pl,https://www.emmastudio.pl

# Strona zrodlowa dla crawlera
SITE_URL=https://emmastudio.pl
SITEMAP_URL=https://emmastudio.pl/sitemap.xml

# Sekret dla endpointu /api/sync (webhook CMS, wywolanie reczne)
SYNC_TOKEN=

# Drugi akceptowany sekret dla /api/sync (np. gdyby wywolywal go harmonogram).
CRON_SECRET=

# Kanal wiedzy publikowany przez strone przy budowaniu. Stad Emmbotek bierze tresc.
KNOWLEDGE_FEED_URL=https://emmastudio.pl/wiedza.json

# Jak dlugo instancja trzyma kanal w pamieci (ms). 5 minut = wiedza swiezsza niz z crona.
KNOWLEDGE_CACHE_TTL_MS=300000

# Kopia zapasowa wgrywana razem z aplikacja - ratuje pierwsza rozmowe po starcie
# instancji, gdyby strona akurat nie oddawala kanalu. Nie jest zapisywana w czasie pracy.
KNOWLEDGE_PATH=data/knowledge.json

# --- Supabase: trwaly zapis luk wiedzy, licznikow CTA i limitow zapytan ----------
# Bez tych dwoch zmiennych Emmbotek dziala normalnie - traci tylko pamiec o tych trzech
# rzeczach (limit spada wtedy do pamieci pojedynczej instancji).
# Tabele i funkcje zaklada sql/001-emmbotek.sql - wklej go do SQL Editor w Supabase.
#
# UWAGA: to jest klucz service_role, ktory omija RLS. Nigdy w przegladarce, nigdy w repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=4000

# --- Ochrona przed naduzyciem -----------------------------------------------------
# Sekret podpisujacy krotkotrwale tokeny wstepu. SAMA JEGO OBECNOSC wlacza ochrone:
# bez tokenu /api/chat odpowiada bledem 401. Wpisz dowolny dlugi losowy ciag.
#
# Po co: naglowek Origin da sie podrobic zwyklym curl-em, wiec allowlista domen sama
# nie chroni przed skryptem palacym limit Gemini. Token wymusza przejscie przez nasza
# strone. To NIE jest reCAPTCHA - nic nie wychodzi poza nasz serwer.
TOKEN_SECRET=
TOKEN_TTL_MS=1200000

# Dzienny budzet zapytan do modelu - twarda granica na wypadek naduzycia.
# Po jej przekroczeniu Emmbotek odsyla do sekretariatu zamiast wolac Gemini.
DAILY_BUDGET=800

# Limity
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
MAX_MESSAGE_CHARS=600
MAX_HISTORY_TURNS=12

# Budzet czasu jednego przebiegu crawlera - musi zmiescic sie w limicie funkcji (30 s na Vercel).
CRAWLER_MAX_DURATION_MS=25000
CRAWLER_DELAY_MS=350
