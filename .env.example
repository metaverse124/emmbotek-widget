# Klucz Gemini - WYLACZNIE po stronie serwera, nigdy w kodzie frontendu.
GEMINI_API_KEY=

# Model (domyslnie gemini-3.6-flash, zapasowo gemini-flash-lite-latest).
# gemini-2.5-flash jest wycofany dla nowych kluczy - odpowiada bledem 404.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Prog przelaczenia na model zapasowy. Model glowny bywa szybki (5-7 s), ale
# potrafi skoczyc do 25 s - wtedy lepiej oddac odpowiedz z modelu lite (1-2 s).
GEMINI_TIMEOUT_MS=9000

# Allowlista Origin (rozdzielona przecinkami)
ALLOWED_ORIGINS=https://emmastudio.pl,https://www.emmastudio.pl

# Strona zrodlowa dla crawlera
SITE_URL=https://emmastudio.pl
SITEMAP_URL=https://emmastudio.pl/sitemap.xml

# Sekret dla endpointu /api/sync (webhook CMS, wywolanie reczne)
SYNC_TOKEN=

# Vercel Cron wysyla wlasny sekret w naglowku Authorization: Bearer $CRON_SECRET.
# Ustaw go w panelu Vercel, inaczej cron dostanie 401 i wiedza nigdy sie nie odswiezy.
CRON_SECRET=

# Sciezka zapisu bazy wiedzy.
# UWAGA: na platformach serverless katalog aplikacji jest tylko do odczytu, a /tmp znika
# razem z instancja. Do produkcji podmien load/save w api/sync.js na trwaly magazyn.
KNOWLEDGE_PATH=data/knowledge.json

# Limity
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
MAX_MESSAGE_CHARS=600
MAX_HISTORY_TURNS=12

# Budzet czasu jednego przebiegu crawlera - musi zmiescic sie w limicie funkcji (30 s na Vercel).
CRAWLER_MAX_DURATION_MS=25000
CRAWLER_DELAY_MS=350
