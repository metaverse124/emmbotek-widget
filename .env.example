# Klucz Gemini - WYLACZNIE po stronie serwera, nigdy w kodzie frontendu.
GEMINI_API_KEY=

# Model (domyslnie gemini-2.5-flash, fallback gemini-flash-latest)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Allowlista Origin (rozdzielona przecinkami)
ALLOWED_ORIGINS=https://emmastudio.pl,https://www.emmastudio.pl

# Strona zrodlowa dla crawlera
SITE_URL=https://emmastudio.pl
SITEMAP_URL=https://emmastudio.pl/sitemap.xml

# Sekret dla endpointu /api/sync (cron / webhook CMS)
SYNC_TOKEN=

# Limity
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
MAX_MESSAGE_CHARS=600
MAX_HISTORY_TURNS=12
